Cell[TextData[{
 "1. V dokumentaciji poi\[SHacek]\[CHacek]ite definicijo konstante ",
 StyleBox["Degree", "Code"],
 ", ki jo uporabite, da napi\[SHacek]ete 1830\[Degree] in 270\[Degree].\n2. \
Ti dve vrednosti spravite v spremenljivki \[Alpha] in \[Beta].\n3. Izra\
\[CHacek]unajte vrednost izraza ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"sin", " ", "\[Alpha]"}], " ", "+", " ", 
     RowBox[{"sin", " ", "\[Beta]"}]}], 
    RowBox[{
     RowBox[{
      SuperscriptBox["cos", "2"], "(", 
      RowBox[{"\[Alpha]", " ", "-", " ", "\[Beta]"}], ")"}], " ", "-", " ", 
     RowBox[{
      SuperscriptBox["sin", "2"], "(", 
      RowBox[{"\[Beta]", "-", "\[Alpha]"}], ")"}]}]], TraditionalForm]],
  ExpressionUUID->"827d52c8-6ab4-400a-bc5c-b9b1880d5c15"],
 " za kota ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"1830", "\[Degree]"}]}], TraditionalForm]],ExpressionUUID->
  "65ec95a4-a610-4997-b60e-fcf10c62c966"],
 "  in  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "=", 
    RowBox[{"270", "\[Degree]"}]}], TraditionalForm]],ExpressionUUID->
  "a46cf43b-ce8b-4477-8e90-551b7c0d9450"],
 ". Pri tem uporabite spremenljivki, ki se ju ravno definirali.\n\
\[CapitalCHacek]e ne \[ZHacek]elite, da se izpi\[SHacek]e vrednost nekega \
izraza, lahko tisto vrstico kon\[CHacek]ate s podpi\[CHacek]jem ",
 StyleBox[";", "Code"],
 "."
}], "Text",
 CellChangeTimes->{{3.6281908759094143`*^9, 3.628190911487608*^9}, {
   3.6281909573783216`*^9, 3.6281911693318605`*^9}, {3.628211934605344*^9, 
   3.6282119373240967`*^9}, {3.7840888715997257`*^9, 
   3.7840889306778507`*^9}, {3.7840889847091084`*^9, 3.784089003505985*^9}, 
   3.784089991287238*^9, 3.78410386769199*^9, {3.909128858420991*^9, 
