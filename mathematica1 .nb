   3.9091306012334642`*^9, 3.909130610859573*^9}, {3.942727292303672*^9, 
   3.9427272969673033`*^9}, {3.9427287979409857`*^9, 
   3.9427288000782013`*^9}, {3.942732151015088*^9, 
   3.942732166419607*^9}},ExpressionUUID->"5d082ded-9162-4e82-a000-\
cd8609822132"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"prostor", " ", "za", " ", "va\[SHacek]e", " ", "re\[SHacek]itve"}],
   "*)"}]], "Input",
 CellChangeTimes->{
  3.942731862879264*^9},ExpressionUUID->"22e68aaf-bfce-455e-b82c-\
6fa70a539aee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"alpha", " ", "=", " ", 
    RowBox[{"1830", " ", "Degree"}]}], "\[IndentingNewLine]", " ", 
   RowBox[{"beta", " ", "=", " ", 
    RowBox[{"270", " ", "Degree"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sin", "[", "alpha", "]"}], "+", 
      RowBox[{"Sin", "[", "beta", "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"alpha", "-", "beta"}], "]"}], "^", "2"}], "-", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"beta", "-", "alpha"}], "]"}], "^", "2"}]}], 
     ")"}]}]}]}]], "Input",
