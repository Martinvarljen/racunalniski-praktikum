Cell[TextData[{
 "1. Izra\[CHacek]unajte  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["lim", 
     RowBox[{"x", "\[Rule]", "0"}]], 
    FractionBox[
     RowBox[{"arctg", " ", 
      RowBox[{"(", 
       RowBox[{"7", "x"}], ")"}]}], 
     RowBox[{"arcsin", " ", 
      RowBox[{"(", 
       RowBox[{"8", "x"}], ")"}]}]]}], TraditionalForm]],ExpressionUUID->
  "a0cdc544-eb31-4144-b8f5-60b398de5389"],
 "\n\n2. Izra\[CHacek]unajte  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["lim", 
     RowBox[{"x", "\[Rule]", "\[Pi]"}]], 
    FractionBox[
     RowBox[{"1", "+", 
      RowBox[{"cos", " ", "x"}]}], 
     RowBox[{
      RowBox[{"2", 
       SqrtBox[
        RowBox[{"\[Pi]", " ", "x"}]]}], "-", "\[Pi]", "-", "x"}]]}], 
   TraditionalForm]],ExpressionUUID->"270b6a20-a683-4d5d-b34e-77077063fed1"],
 "\n3. Izra\[CHacek]unajte levo limito:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["lim", 
     RowBox[{"x", "\[Rule]", 
      SuperscriptBox["0", "-"]}]], 
    RowBox[{"|", "x", "|", 
     RowBox[{"ctg", " ", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "ddd823e5-1ff3-445d-b160-e3d07fb78af4"]
}], "Text",
