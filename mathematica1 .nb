  RowBox[{
   RowBox[{
    RowBox[{"q", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "2"}], 
         RowBox[{"(", 
          RowBox[{"y", "-", "1"}], ")"}]}], "-", 
        RowBox[{
         RowBox[{"x", "^", "3"}], 
         RowBox[{"y", "^", "5"}]}], "+", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "1"}], ")"}], "^", "7"}], "x", " ", "y", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "^", "2"}], "+", 
           RowBox[{"2", "x", " ", "y"}], "+", 
           RowBox[{"y", "^", "3"}]}], ")"}]}]}], ")"}], "^", "2"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Total", "[", 
    RowBox[{"MonomialList", "[", "q", "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Collect", "[", 
    RowBox[{"q", ",", "x"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Exponent", "[", 
    RowBox[{"q", ",", "x"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Exponent", "[", 
    RowBox[{"q", ",", "y"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.945005105583988*^9, 3.945005354307356*^9}, {
